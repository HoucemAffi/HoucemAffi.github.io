---
import Icon from './Icon.astro';
import projects from '../data/projects.json';
import { ui, experience, toolbox, links, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const otherHref = lang === 'fr' ? '/' : '/fr/';
const otherLabel = lang === 'fr' ? 'EN' : 'FR';
const stats = t.stats.map((s, i) => (i === 1 ? { ...s, value: String(projects.length) } : s));

type Project = (typeof projects)[number] & { image?: string; company?: string; url?: string; featured?: boolean };
const list = projects as Project[];
const shot = (p: Project) =>
  p.image ? p.image : p.url ? `https://s0.wp.com/mshots/v1/${encodeURIComponent(p.url)}?w=1200&h=750` : null;
const host = (u?: string) => (u ? u.replace(/^https?:\/\//, '').replace(/\/$/, '') : '');
const groupKeys = ['all', 'metam', 'leadiya', 'freelance', 'earlier'] as const;
const counts = Object.fromEntries(groupKeys.map((g) => [g, g === 'all' ? list.length : list.filter((p) => p.group === g).length]));
---
<header class="sticky top-3 z-40 px-4">
  <nav class="glass mx-auto flex max-w-6xl items-center justify-between gap-3 !rounded-full px-3 py-2 sm:px-4" aria-label="Main">
    <a href="#top" class="flex items-center gap-2.5 rounded-full pr-2 font-display font-bold" aria-label="Houcem AFI — home">
      <img src="/images/houcem-avatar.webp" alt="" width="36" height="36" class="h-9 w-9 rounded-full object-cover ring-2 ring-[var(--signature)]" />
      <span class="hidden sm:inline">Houcem AFI</span>
    </a>
    <ul class="hidden items-center gap-1 text-sm font-medium md:flex">
      <li><a class="rounded-full px-3 py-2 muted hover:text-[var(--text)]" href="#work">{t.nav.work}</a></li>
      <li><a class="rounded-full px-3 py-2 muted hover:text-[var(--text)]" href="#expertise">{t.nav.expertise}</a></li>
      <li><a class="rounded-full px-3 py-2 muted hover:text-[var(--text)]" href="#experience">{t.nav.experience}</a></li>
      <li><a class="rounded-full px-3 py-2 muted hover:text-[var(--text)]" href="#about">{t.nav.about}</a></li>
    </ul>
    <div class="flex items-center gap-1.5">
      <a href={otherHref} hreflang={lang === 'fr' ? 'en' : 'fr'} class="tab !min-h-[40px] !px-3 font-semibold" aria-label={t.langSwitch}>{otherLabel}</a>
      <button id="theme-toggle" type="button" class="tab !min-h-[40px] !px-2.5" aria-label={t.themeToggle}>
        <span class="dark:hidden"><Icon name="moon" class="h-5 w-5" /></span>
        <span class="hidden dark:inline"><Icon name="sun" class="h-5 w-5" /></span>
      </button>
      <a href="#contact" class="btn btn-primary !min-h-[40px] !py-2 !text-sm">{t.nav.contact}</a>
    </div>
  </nav>
</header>

<main id="main" class="mx-auto max-w-6xl px-4 pb-16">
  <!-- HERO BENTO -->
  <section id="top" class="grid grid-cols-2 gap-4 pt-8 lg:grid-cols-12 lg:pt-12">
    <div class="glass reveal col-span-2 flex flex-col justify-between gap-8 p-7 sm:p-10 lg:col-span-7">
      <div>
        <p class="mb-6 inline-flex items-center gap-2.5 rounded-full border border-[var(--surface-border)] bg-[var(--signature-soft)] px-3.5 py-1.5 text-sm font-medium">
          <span class="pulse" aria-hidden="true"></span>{t.available}
        </p>
        <p class="muted mb-2 text-lg font-medium">{t.hello}</p>
        <h1 class="text-4xl font-extrabold leading-[1.08] sm:text-5xl lg:text-[3.4rem]">
          {t.role.split(' & ')[0]} <span class="bg-gradient-to-r from-[var(--primary)] to-[var(--signature)] bg-clip-text text-transparent">&amp; {t.role.split(' & ')[1]}</span>
        </h1>
        <p class="muted mt-5 max-w-xl text-[1.06rem] leading-relaxed">{t.pitch}</p>
      </div>
      <div>
        <div class="flex flex-wrap gap-3">
          <a href="#work" class="btn btn-primary">{t.ctaWork}<Icon name="arrowDown" class="h-4 w-4" /></a>
          <a href="#contact" class="btn btn-ghost">{t.ctaContact}</a>
          <a href={links.cv} class="btn btn-ghost" download><Icon name="download" class="h-4 w-4" />{t.ctaCv}</a>
        </div>
        <p class="muted mt-6 flex items-start gap-2 text-sm"><Icon name="pin" class="mt-0.5 h-4 w-4 shrink-0" />{t.location}</p>
      </div>
    </div>

    <div class="reveal relative min-h-[420px] overflow-hidden rounded-[1.5rem] border border-[var(--surface-border)] shadow-[var(--shadow)] col-span-2 lg:col-span-5"
      style="background: radial-gradient(120% 90% at 50% 15%, #2f6db5 0%, #123a6e 45%, #0b1e3a 100%);">
      <div class="absolute inset-0 opacity-30" style="background-image: radial-gradient(rgba(255,255,255,.25) 1px, transparent 1px); background-size: 18px 18px;" aria-hidden="true"></div>
      <img src="/images/houcem-hero.webp" alt="Houcem AFI" width="900" height="1125" fetchpriority="high"
        class="absolute bottom-0 left-1/2 h-[96%] w-auto max-w-none -translate-x-1/2 object-contain object-bottom drop-shadow-[0_20px_40px_rgba(0,0,0,.45)]" />
      <div class="glass absolute bottom-4 left-4 right-4 flex items-center justify-between gap-3 !rounded-2xl !bg-[rgba(7,15,30,.55)] px-4 py-3 text-white !border-white/15">
        <div>
          <p class="font-display text-base font-bold">Houcem AFI</p>
          <p class="text-xs text-white/75">WordPress · WooCommerce · PHP · API</p>
        </div>
        <div class="flex gap-1.5">
          <a href={links.linkedin} target="_blank" rel="noopener" class="grid h-10 w-10 place-items-center rounded-full bg-white/10 hover:bg-white/20" aria-label="LinkedIn"><Icon name="linkedin" class="h-4 w-4" /></a>
          <a href={links.github} target="_blank" rel="noopener" class="grid h-10 w-10 place-items-center rounded-full bg-white/10 hover:bg-white/20" aria-label="GitHub"><Icon name="github" class="h-4 w-4" /></a>
        </div>
      </div>
    </div>

    {stats.map((s) => (
      <div class="glass reveal p-5 sm:p-6 lg:col-span-3">
        <p class="font-display text-3xl font-extrabold text-primary-c sm:text-4xl">{s.value}</p>
        <p class="muted mt-1 text-sm leading-snug">{s.label}</p>
      </div>
    ))}
  </section>

  <!-- EXPERTISE -->
  <section id="expertise" class="pt-24">
    <div class="reveal mb-8 max-w-2xl">
      <p class="eyebrow">{t.nav.expertise}</p>
      <h2 class="mt-2 text-3xl font-bold sm:text-4xl">{t.expertiseTitle}</h2>
      <p class="muted mt-3 text-lg">{t.expertiseLead}</p>
    </div>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {t.expertise.map((e, i) => (
        <article class={`glass reveal p-6 ${i === 0 ? 'lg:row-span-2 flex flex-col' : ''} ${i === 5 ? 'sm:col-span-2 lg:col-span-3 lg:flex lg:items-center lg:gap-6' : ''}`}>
          <div class="mb-4 grid h-12 w-12 shrink-0 place-items-center rounded-2xl lg:mb-0 bg-[var(--signature-soft)] text-primary-c">
            <Icon name={e.icon} class="h-6 w-6" />
          </div>
          <h3 class="shrink-0 text-lg font-bold">{e.title}</h3>
          <p class="muted mt-2 leading-relaxed">{e.text}</p>
          {i === 0 && (
            <div class="mt-auto flex flex-wrap gap-2 pt-6">
              {['Themes', 'Plugins', 'Elementor', 'Headless', 'Polylang', 'ACF', 'REST'].map((c) => <span class="chip">{c}</span>)}
            </div>
          )}
        </article>
      ))}
    </div>

    <div class="marquee mt-6 overflow-hidden py-2" aria-label={t.stackTitle}>
      <div class="marquee-track">
        {[...toolbox, ...toolbox].map((tool, i) => (
          <span class="chip !px-4 !py-2 !text-sm" aria-hidden={i >= toolbox.length ? 'true' : undefined}>{tool}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- WORK -->
  <section id="work" class="pt-24">
    <div class="reveal mb-6 flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div class="max-w-2xl">
        <p class="eyebrow">{t.nav.work}</p>
        <h2 class="mt-2 text-3xl font-bold sm:text-4xl">{t.workTitle}</h2>
        <p class="muted mt-3 text-lg">{t.workLead}</p>
      </div>
    </div>
    <div class="reveal mb-6 flex flex-wrap gap-2" role="group" aria-label={t.workTitle}>
      {groupKeys.map((g) => (
        <button type="button" class="tab" data-filter={g} aria-pressed={g === 'all' ? 'true' : 'false'}>
          {t.filters[g]} <span class="ml-1 opacity-70">{counts[g]}</span>
        </button>
      ))}
    </div>

    <div id="projects" class="grid grid-flow-dense grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {list.map((p) => {
        const img = shot(p);
        return (
          <article class={`project glass reveal flex flex-col overflow-hidden ${p.featured ? 'lg:col-span-2' : ''}`} data-group={p.group}>
            <div class={`shot relative overflow-hidden border-b border-[var(--surface-border)] ${p.featured ? 'aspect-[16/10] lg:aspect-[16/7]' : 'aspect-[16/10]'}`}
              style="background: linear-gradient(135deg, #0b1e3a 0%, #1e4e8c 60%, #7fb2e5 140%);">
              <div class="absolute inset-0 grid place-items-center p-6 text-center text-white">
                <div>
                  <p class="font-display text-2xl font-extrabold tracking-tight">{p.title}</p>
                  <p class="mt-1 inline-flex items-center gap-1.5 text-xs text-white/70">
                    {p.url ? <Icon name="globe" class="h-3.5 w-3.5" /> : <Icon name="lock" class="h-3.5 w-3.5" />}
                    {p.url ? host(p.url) : t.privateProject}
                  </p>
                </div>
              </div>
              {img && (
                <img src={img} alt={`${p.title} — ${p.type[lang]}`} loading="lazy" decoding="async" width="1200" height="750"
                  class="absolute inset-0 h-full w-full object-cover object-top" onerror="this.remove()" />
              )}
              <span class="chip absolute left-3 top-3 !bg-[rgba(7,15,30,.6)] !text-white !border-white/15 backdrop-blur">
                {p.company ?? t.groups[p.group as keyof typeof t.groups]}
              </span>
            </div>
            <div class="flex flex-1 flex-col p-5 sm:p-6">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wider text-primary-c">{p.type[lang]}</p>
                  <h3 class="mt-1 text-xl font-bold">{p.title}</h3>
                </div>
                <span class="muted shrink-0 pt-0.5 text-xs">{p.year}</span>
              </div>
              <p class="muted mt-2.5 text-[0.95rem] leading-relaxed">{p.desc[lang]}</p>
              <div class="mt-4 flex flex-wrap gap-1.5">{p.stack.map((s) => <span class="chip">{s}</span>)}</div>
              {p.url && (
                <a href={p.url} target="_blank" rel="noopener" class="mt-auto inline-flex min-h-[44px] items-center gap-1.5 pt-4 text-sm font-semibold text-primary-c hover:underline">
                  {t.visit} · {host(p.url)} <Icon name="arrow" class="h-4 w-4" />
                </a>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- EXPERIENCE + ABOUT -->
  <section id="experience" class="grid grid-cols-1 gap-4 pt-24 lg:grid-cols-12">
    <div class="glass reveal p-7 sm:p-9 lg:col-span-7">
      <p class="eyebrow">{t.nav.experience}</p>
      <h2 class="mt-2 text-3xl font-bold">{t.experienceTitle}</h2>
      <ol class="mt-8 space-y-7 border-l border-[var(--surface-border)] pl-6">
        {experience.map((e, i) => (
          <li class="relative">
            <span class={`absolute -left-[31px] top-1.5 h-3 w-3 rounded-full ring-4 ring-[var(--bg)] ${i === 0 ? 'bg-[var(--primary)]' : 'bg-[var(--signature)]'}`} aria-hidden="true"></span>
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="text-lg font-bold">{e.company}</h3>
              <span class="muted text-sm">{e.years[lang]}</span>
            </div>
            <p class="text-sm font-semibold text-primary-c">{e.role[lang]} · <span class="muted font-normal">{e.place[lang]}</span></p>
            <p class="muted mt-1.5 leading-relaxed">{e.text[lang]}</p>
          </li>
        ))}
      </ol>
    </div>

    <div id="about" class="flex flex-col gap-4 lg:col-span-5">
      <div class="glass reveal overflow-hidden">
        <img src="/images/houcem-work.webp" alt={lang === 'fr' ? 'Houcem au travail sur son ordinateur' : 'Houcem working on his laptop'} loading="lazy" width="1000" height="1500"
          class="aspect-[4/3] w-full object-cover object-[50%_30%]" />
        <div class="p-7">
          <p class="eyebrow">{t.nav.about}</p>
          <h2 class="mt-2 text-2xl font-bold">{t.aboutTitle}</h2>
          {t.about.map((para) => <p class="muted mt-3 leading-relaxed">{para}</p>)}
        </div>
      </div>
      <div class="glass reveal p-7">
        <h3 class="flex items-center gap-2 text-lg font-bold"><Icon name="grad" class="h-5 w-5 text-primary-c" />{t.educationTitle}</h3>
        <ul class="mt-4 space-y-4">
          {t.education.map((ed) => (
            <li>
              <p class="font-semibold leading-snug">{ed.degree}</p>
              <p class="muted text-sm">{ed.school} · {ed.years}</p>
            </li>
          ))}
        </ul>
        <h3 class="mt-6 flex items-center gap-2 text-lg font-bold"><Icon name="globe" class="h-5 w-5 text-primary-c" />{t.languagesTitle}</h3>
        <p class="muted mt-2 text-sm">{t.languages}</p>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="pt-24">
    <div class="reveal relative overflow-hidden rounded-[1.75rem] p-8 text-white shadow-[var(--shadow)] sm:p-12"
      style="background: radial-gradient(100% 140% at 85% 0%, #2f6db5 0%, #123a6e 45%, #0b1e3a 100%);">
      <div class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-[#7fb2e5]/30 blur-3xl" aria-hidden="true"></div>
      <div class="relative max-w-2xl">
        <h2 class="text-3xl font-extrabold sm:text-4xl">{t.contactTitle}</h2>
        <p class="mt-3 text-lg text-white/80">{t.contactLead}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={`mailto:${links.email}`} class="btn bg-white text-[#0b1e3a] hover:bg-[#eaf2fd]"><Icon name="mail" class="h-4 w-4" />{t.email}</a>
          <a href={links.linkedin} target="_blank" rel="noopener" class="btn border border-white/25 bg-white/10 text-white hover:bg-white/20"><Icon name="linkedin" class="h-4 w-4" />LinkedIn</a>
          <a href={links.cv} download class="btn border border-white/25 bg-white/10 text-white hover:bg-white/20"><Icon name="download" class="h-4 w-4" />{t.ctaCv}</a>
        </div>
        <p class="mt-6 text-sm text-white/70">{links.email}</p>
      </div>
    </div>
  </section>
</main>

<footer class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 px-4 pb-10 text-sm muted sm:flex-row">
  <p>© {new Date().getFullYear()} Houcem AFI. {t.footer}</p>
  <div class="flex gap-4">
    <a href={links.linkedin} target="_blank" rel="noopener" class="hover:text-[var(--text)]">LinkedIn</a>
    <a href={links.github} target="_blank" rel="noopener" class="hover:text-[var(--text)]">GitHub</a>
    <a href={otherHref} class="hover:text-[var(--text)]">{t.langSwitch}</a>
  </div>
</footer>

<script>
  // Theme toggle
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (e) {}
  });

  // Project filters
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('#projects [data-group]');
  tabs.forEach((tab) =>
    tab.addEventListener('click', () => {
      const f = tab.dataset.filter;
      tabs.forEach((x) => x.setAttribute('aria-pressed', String(x === tab)));
      cards.forEach((c) => {
        c.hidden = !(f === 'all' || c.dataset.group === f);
        if (!c.hidden) c.classList.add('in');
      });
    })
  );

  // Scroll reveal
  const els = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
      { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
    );
    els.forEach((el) => io.observe(el));
  } else {
    els.forEach((el) => el.classList.add('in'));
  }
</script>
